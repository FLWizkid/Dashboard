# Keep the build context small and — more importantly — keep secrets and
# local state out of the image entirely.

.git
.github
node_modules
.next
out
build
coverage
test-results
playwright-report
blob-report
playwright/.cache

# Never copy real environment files into an image layer.
.env
.env.*
!.env.example

# Runtime state that lives on the box, not in the image.
ops/data
ops/backups
ops/caddy/certs

*.tsbuildinfo
npm-debug.log*
.DS_Store
