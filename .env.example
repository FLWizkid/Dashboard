# ─────────────────────────────────────────────────────────────────────────
# CIO Executive Dashboard — environment template
# Copy this file to `.env.local` and fill in the values.
# NEVER commit `.env.local` or real keys. `.gitignore` already excludes them.
# The repository is public: every secret lives only on your box.
# ─────────────────────────────────────────────────────────────────────────

# Self-hosted Supabase — runs on your Windows/WSL2 box, reachable over Tailscale.
# Use the Tailscale hostname or 100.x.y.z address of that box, e.g.
#   https://dashboard.your-tailnet.ts.net
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Bypasses Row Level Security — keep OUT of the browser and OUT of git.
# Only read in server-side code; never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────
# Testing only — never set these on the box.
# ─────────────────────────────────────────────────────────────────────────

# `memory` swaps the Supabase repository for an in-process one and bypasses
# auth so Playwright can run without a database. It is ignored entirely when
# NODE_ENV=production, so a production build cannot be put into this mode.
# DASHBOARD_DATA_MODE=memory

# Postgres connection string for the RLS integration tests. When unset those
# tests skip. CI provides a throwaway container; locally you can point it at a
# scratch database — never at the one holding your real data.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
